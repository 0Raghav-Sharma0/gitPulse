# Copy these into Vercel → Project → Settings → Environment Variables
# Production URL: https://git-pulse-bice.vercel.app

# --- Required for auth (use your production URL) ---
APP_URL=https://git-pulse-bice.vercel.app
AUTH_URL=https://git-pulse-bice.vercel.app
NEXTAUTH_URL=https://git-pulse-bice.vercel.app
NEXT_PUBLIC_APP_URL=https://git-pulse-bice.vercel.app

# GitHub OAuth App → add callback URL:
#   https://git-pulse-bice.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# --- Database (Neon / Vercel Postgres / Supabase) ---
# DATABASE_URL = pooled connection string (for the app)
# DIRECT_URL   = direct / non-pooled URL (required for Prisma migrations on Vercel)
DATABASE_URL=
DIRECT_URL=

# --- Redis (Upstash recommended on Vercel) ---
REDIS_URL=

# --- App secrets ---
GITHUB_TOKEN=
GEMINI_API_KEY=
ADMIN_GITHUB_USERNAME=

NEXT_PUBLIC_CONTACT_EMAIL=

# Optional
BLOB_READ_WRITE_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_URL=
KV_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
EMAIL_RETRY_JOB_SECRET=
CRON_SECRET=
