# Copy to .env.production and fill in before deploying:
#   cp .env.production.example .env.production

# Public URL of your deployment (HTTPS in production)
APP_URL=https://your-domain.com
APP_PORT=3000

# Postgres (used by docker-compose.prod.yml — pick a strong password)
POSTGRES_USER=gitpulse
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=gitpulse

# GitHub OAuth — add callback: ${APP_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

NEXT_PUBLIC_CONTACT_EMAIL=
ADMIN_GITHUB_USERNAME=

GITHUB_TOKEN=
GEMINI_API_KEY=

# Optional: Vercel Blob / KV (if you still use them alongside Docker)
BLOB_READ_WRITE_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
EMAIL_RETRY_JOB_SECRET=
CRON_SECRET=
